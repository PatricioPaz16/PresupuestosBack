NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# PostgreSQL (local pgAdmin o Docker)
# Local: usa la contraseña de tu usuario postgres en Windows (no tiene que ser "postgres")
# Ver SETUP-POSTGRES-LOCAL.md
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=back_base_nest

# Desarrollo rápido: crea/actualiza tablas automáticamente (no usar en producción)
TYPEORM_SYNC=true
# Producción / staging: ejecutar migraciones al arranque
TYPEORM_RUN_MIGRATIONS=false

JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_COOKIE_MAX_AGE_MS=900000
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000

LOG_LEVEL=info

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
