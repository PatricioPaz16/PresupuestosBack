NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# PostgreSQL (local con pgAdmin o Docker) — ver SETUP-POSTGRES-LOCAL.md
# Local: usá la contraseña de tu usuario postgres (no tiene por qué ser "postgres").
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=back_base_nest
# Conexión cifrada: true en Supabase y bases en la nube.
DB_SSL=false
# Opcional: CA para verificar el certificado del servidor (Supabase: Database Settings >
# SSL Configuration > Download certificate). Sin esto, va cifrada sin verificar.
# DB_SSL_CA=./prod-ca-2021.crt

# Supabase (pooler, ver SETUP.md > Producción):
# DB_HOST=aws-1-us-west-2.pooler.supabase.com
# DB_PORT=6543
# DB_USERNAME=postgres.<referencia-del-proyecto>
# DB_NAME=postgres
# DB_SSL=true

# Esquema de base de datos: SOLO migraciones (el sincronizado automático de TypeORM
# quedó desactivado porque no crea triggers, políticas RLS ni columnas generadas).
# true (por defecto) = la API aplica las migraciones pendientes al arrancar.
# false = las corrés a mano con `npm run migration:run`.
TYPEORM_RUN_MIGRATIONS=true

JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_COOKIE_MAX_AGE_MS=900000
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000

LOG_LEVEL=info

# Detrás de proxies (Render, Vercel): true toma la IP real del cliente para el límite de
# intentos de login. Vacío = 1 salto en producción, ninguno en desarrollo.
# TRUST_PROXY=true

# Tamaño máximo del body JSON (el logo del taller viaja como imagen en base64).
BODY_LIMIT=1mb

# Primer arranque con la base vacía: crea el taller "Taller Demo" y este administrador.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
# true = carga además un catálogo de ejemplo (repuestos y mano de obra), 2 clientes y
# 3 vehículos en el primer taller, solo si ese taller todavía no tiene catálogo.
SEED_DEMO=false
